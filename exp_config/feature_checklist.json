[
  {
    "id": "marketplace_search_match",
    "name": "Marketplace search and match",
    "description": "Guests can search for rental listings by location, dates, price range, or amenities. Results are filtered and ranked. Includes listing browsing/discovery UI or API.",
    "detection": {
      "file_patterns": ["*search*", "*listing*", "*browse*", "*discover*", "*marketplace*"],
      "import_keywords": ["search", "filter", "listing", "property"],
      "route_patterns": ["/search", "/listings", "/browse", "/properties"],
      "schema_keywords": ["location", "price", "amenities", "availability", "dates"],
      "code_keywords": ["search", "filter", "query", "listings", "properties"]
    }
  },
  {
    "id": "booking_lifecycle_management",
    "name": "Booking lifecycle management",
    "description": "Full booking state machine: inquiry → pending → confirmed → active/in-stay → completed, with cancellation and status transitions modelled in code.",
    "detection": {
      "file_patterns": ["*booking*", "*reservation*", "*stay*"],
      "import_keywords": ["booking", "reservation", "status"],
      "route_patterns": ["/book", "/booking", "/reservation", "/cancel", "/confirm"],
      "schema_keywords": ["status", "confirmed", "pending", "cancelled", "completed", "inquiry", "active"],
      "code_keywords": ["PENDING", "CONFIRMED", "CANCELLED", "COMPLETED", "IN_STAY", "inquiry", "state_machine", "transition"]
    }
  },
  {
    "id": "multi_stay_support",
    "name": "Multi-stay support",
    "description": "A guest can have multiple simultaneous or sequential bookings/trips. The data model supports multiple bookings per user.",
    "detection": {
      "file_patterns": ["*booking*", "*trip*", "*stay*"],
      "import_keywords": ["bookings", "trips"],
      "route_patterns": ["/bookings", "/trips", "/my-stays"],
      "schema_keywords": ["user_id", "guest_id", "bookings", "trips"],
      "code_keywords": ["get_bookings", "user_bookings", "list_bookings", "all_bookings", "multiple"]
    }
  },
  {
    "id": "long_lived_interactions",
